APP_NAME=Screenshot Ingestion API
APP_ENV=dev
INGESTED_OUTPUT_DIR=data/ingested

# Azure AI Foundry / Agent Gateway endpoint settings.
# Example URL (OpenAI-compatible responses endpoint):
# https://<your-endpoint>/openai/v1/responses
AZURE_AGENT_API_URL=
AZURE_AGENT_API_KEY=
AZURE_AGENT_MODEL=
AZURE_AGENT_API_VERSION=

# Parsing prompt that guides extraction.
AGENT_EXTRACTION_PROMPT=Parse this screenshot and return valid JSON only. Include top-level keys: data (object), warnings (array of strings), confidence (object with overall and optional fields map).

# HTTP timeout in seconds for upstream agent calls.
AGENT_TIMEOUT_SECONDS=45
